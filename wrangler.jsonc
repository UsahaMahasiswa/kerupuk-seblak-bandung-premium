{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kerupuk-seblak-bandung-premium",
  "main": "worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kerupuk-seblak-db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_D1"
    }
  ]
}
